# Venue-local watchdog template.
#
# The venue runtime config is generated by venue_engine.sh before this unit is
# started. Example:
#   systemctl --user enable --now memos-venue-watchdog@binance.service
#
# This unit is intentionally not enabled by default while the legacy
# memos-watchdog.service remains the active owner.

[Unit]
Description=Memos %i Venue Watchdog
After=memos-venue-engine@%i.service
Requires=memos-venue-engine@%i.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/memos/memos_trading_refactor
Environment=RTC_LAUNCH_CONF=/opt/memos/memos_trading_refactor/logs/.venue-runtime/profiles/%i.conf
Environment=ENGINE_PID_PATH=/opt/memos/memos_trading_refactor/logs/.venue-runtime/state/%i.engine.pid
Environment=WATCHDOG_PAUSE_FILE=/opt/memos/memos_trading_refactor/logs/.venue-runtime/state/%i.watchdog.pause
Environment=WATCHDOG_LOCK_DIR=/opt/memos/memos_trading_refactor/logs/.venue-runtime/state/%i.watchdog.lock
Environment=WATCHDOG_LOG_PATH=/opt/memos/memos_trading_refactor/logs/.venue-runtime/state/%i.watchdog.log
Environment=VENUE_NAME=%i
ExecStart=/opt/memos/memos_trading_refactor/scripts/watchdog.sh --release
Restart=always
RestartSec=10
KillMode=process

[Install]
WantedBy=default.target
